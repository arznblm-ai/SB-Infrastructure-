[Unit]
Description=Kris - проектный компаньон владельца (Telegram + claude CLI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/kris/workspace
Environment=HOME=/root
EnvironmentFile=/root/.config/kris/.env
ExecStart=/opt/kris/venv/bin/python /opt/kris/kris_bot.py
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
