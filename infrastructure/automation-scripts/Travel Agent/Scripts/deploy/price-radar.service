[Unit]
Description=Travel Agent (Марко): ежедневный радар цен на авиабилеты
Documentation=file:///root/second-brain/infrastructure/Travel Agent/Scripts/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/second-brain/infrastructure/Travel Agent/Scripts
EnvironmentFile=/root/.config/second-brain/travel.env
ExecStart=/usr/bin/python3 price_radar.py
TimeoutStartSec=600
# Логи смотреть через journalctl -u price-radar
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
