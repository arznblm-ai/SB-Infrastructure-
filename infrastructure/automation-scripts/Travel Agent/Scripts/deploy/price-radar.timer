[Unit]
Description=Travel price radar — ежедневно в 09:00 по Москве

[Timer]
OnCalendar=*-*-* 09:00:00
# Явная зона: не зависим от таймзоны сервера (нужен systemd >= 251, см. README)
Timezone=Europe/Moscow
Persistent=true
RandomizedDelaySec=300
Unit=price-radar.service

[Install]
WantedBy=timers.target
