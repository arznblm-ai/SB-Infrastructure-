<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.krisp-audio-capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/anton/.krisp-obsidian/krisp_audio_capture.py</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Users/anton/Library/Application Support/Krisp/call-recordings</string>
    </array>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/anton/Library/Logs/krisp-audio-capture.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/anton/Library/Logs/krisp-audio-capture.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
